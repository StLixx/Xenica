    {
      "key": "lec_1",
      "parent": "lec",
      "md": "## 基本积分公式"
    },
    {
      "key": "lec_2",
      "parent": "lec",
      "md": "$$\\int x^\\mu\\,dx = \\frac{x^{\\mu+1}}{\\mu+1} + C \\quad (\\mu \\ne -1)$$ #必备 #积分公式"
    },
    {
      "key": "lec_3",
      "parent": "lec",
      "md": "$$\\int \\frac{1}{x}\\,dx = \\ln|x| + C$$ #必备 #积分公式"
    },
    {
      "key": "lec_4",
      "parent": "lec",
      "md": "$$\\int \\sec^2 x\\,dx = \\tan x + C$$ #必备 #积分公式"
    },
    {
      "key": "lec_5",
      "parent": "lec",
      "md": "$$\\int \\sec x\\,dx = \\ln|\\sec x + \\tan x| + C$$ #考前背 #积分公式"
    },
    {
      "key": "lec_6",
      "parent": "lec",
      "md": "$$\\int \\frac{dx}{a^2+x^2} = \\frac{1}{a}\\arctan\\frac{x}{a} + C$$ #考前背 #积分公式"
    },
    {
      "key": "lec_7",
      "parent": "lec",
      "md": "$$\\int \\frac{dx}{\\sqrt{a^2-x^2}} = \\arcsin\\frac{x}{a} + C$$ #考前背 #积分公式"
    },
    {
      "key": "lec_8",
      "parent": "lec",
      "md": "## 常见极限处理"
    },
    {
      "key": "lec_9",
      "parent": "lec",
      "md": "**等价无穷小替换**：$x\\to 0$ 时 $\\sin x \\sim \\tan x \\sim \\ln(1+x) \\sim e^x-1 \\sim x$。只能在乘除里换，加减里不能直接换。 #必备 #极限方法"
    },
    {
      "key": "lec_10",
      "parent": "lec",
      "md": "**$1^\\infty$ 型**：$\\lim u^v = e^{\\lim v(u-1)}$。触发特征：底数趋于 1、指数趋于无穷。 #极限方法"
    },
    {
      "key": "lec_11",
      "parent": "lec",
      "md": "12:40 老师说分部积分下节课讲，到时候回来补。"
    }
  ]

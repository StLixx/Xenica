# 安装：见 AGENTS.md「部署」。仓库 checkout 在 /opt/xenica。
[Unit]
Description=Xenica deployer (pull images, run previews)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/xenica
# 先更新仓库，部署器和 compose 文件都以 master 为准。
ExecStartPre=/usr/bin/git -C /opt/xenica pull --ff-only --quiet
ExecStart=/bin/bash /opt/xenica/deploy/deployer/deploy.sh

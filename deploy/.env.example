# 复制为 .env（不要提交）。正式站和 Traefik 共用。

# 数据库密码，只用字母数字：openssl rand -hex 24
POSTGRES_PASSWORD=

# Traefik 绑定的地址。本机试用 127.0.0.1；core-server 上填 Tailscale IP 100.100.1.103
XENICA_BIND=127.0.0.1
XENICA_PORT=8080

# 正式站域名（预览是 pr-<号>.<这个域名>）
XENICA_HOST=xenica.truebigsand.top

# 镜像。部署器会把它换成具体的 commit 标签
XENICA_IMAGE=ghcr.io/stlixx/xenica:latest

RUST_LOG=info

# 可选：给部署器用的 GitHub token（细粒度，只给本仓库 Issues 读写）。
# 有它时上线失败会自动开缺陷 Issue；没有就只记日志。
DEPLOYER_GITHUB_TOKEN=

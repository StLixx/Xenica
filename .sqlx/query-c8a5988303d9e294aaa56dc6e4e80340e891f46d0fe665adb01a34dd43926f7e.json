  "query": "select n.id, n.kind, n.title, n.body, n.created_at, n.updated_at\n               from edges e join nodes n on n.id = e.target\n               where e.source = $1 and e.kind = 'contains'\n               order by e.pos nulls last, e.created_at, e.id",

    "@types/node": "^20.19.6",
    "@vitest/eslint-plugin": "^1.1.40",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "genversion": "^3.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript": "5.5.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.7"
  },
  "dependencies": {
    "tldts": "^7.0.5"
  }
}
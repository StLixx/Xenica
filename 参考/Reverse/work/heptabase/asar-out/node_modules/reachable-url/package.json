{
  "name": "reachable-url",
  "description": "Given an url resolve it as fast as possible",
  "homepage": "https://github.com/Kikobeats/reachable-url",
  "version": "1.8.3",
  "main": "index.js",
  "author": {
    "email": "josefrancisco.verdu@gmail.com",
    "name": "Kiko Beats",
    "url": "https://kikobeats.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kikobeats/reachable-url.git"
  },
  "dependencies": {
    "got": "~11.8.0",
    "p-reflect": "~2.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@kikobeats/cacheable-request": "latest",
    "@ksmithut/prettier-standard": "latest",
    "async-listen": "latest",
    "ava": "latest",
    "c8": "latest",
    "ci-publish": "latest",
    "finepack": "latest",
    "git-authors-cli": "latest",
    "github-generate-release": "latest",
    "nano-staged": "latest",
    "simple-git-hooks": "latest",
    "standard": "latest",
    "standard-markdown": "latest",
    "standard-version": "latest"
  },
  "engines": {
    "node": ">=8"
  },
  "files": [
    "index.js"
  ],
  "license": "MIT",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "nano-staged": {
    "*.js": [
      "prettier-standard",
      "standard --fix"
    ],
    "package.json": [
      "finepack"
    ]
  },
  "pnpm": {
    "neverBuiltDependencies": [],
    "overrides": {
      "got>cacheable-request": "npm:@kikobeats/cacheable-request"
    }
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit",
    "pre-commit": "npx nano-staged"
  }
}
    "minipass": "^7.0.3",
    "minipass-collect": "^2.0.1",
    "minipass-flush": "^1.0.5",
    "minipass-pipeline": "^1.2.4",
    "p-map": "^7.0.2",
    "ssri": "^13.0.0",
    "unique-filename": "^5.0.0"
  },
  "devDependencies": {
    "@npmcli/eslint-config": "^6.0.1",
    "@npmcli/template-oss": "4.28.0",
    "tap": "^16.0.0"
  },
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "templateOSS": {

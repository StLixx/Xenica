{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Orion": {
    "SymmetricSecurityKey": "TheBrainLocalOrionNoteImageToken",
    "UploadDirectory": "%APPDATA%/Temp/OrionUploads"
  },
  "Venus": {
    "FaviconCachePath": "%APPDATA%/Favicons",
    "FaviconServlet": "/favicon"
  },
  "MarkdownEditor": {
    "ImagesFolder": "%APPDATA%/Temp/NoteImages",
    "PdfTempFolder": "%APPDATA%/Temp/NotePdfs"
  },
  "TheBrain": {
    "EnableAi": true,
    "OpenAiApiKey": null,
    "AnthropicApiKey": null,
    "AnthropicModel": null,
    "LocalAiEndpoint": "http://localhost:1234/v1",
    "LocalAiModel": null,
    "EnableLocalAi": false,
    "IsEnterpriseServer": false,
    "ShortUrlHost": "bra.in",
    "SearchIndexDirectory": "%APPDATA%/Index",
    "SearchIndexBackupDirectory": "%APPDATA%/IndexBackup",
    "MaxFileSizeToExtractFrom": "50000000",
    "MaxApproxExtractedTextLength": "1000000",
    "AttachmentIndexing": "All",
    "IndexExternalAttachmentContent": "false",
    "DisableAllCrossBrainSearch": "false",
    "DisableUserCrossBrainSearch": "false",
    "DisablePublicCrossBrainSearch": "false",
    "UploadTempDirectory": "%APPDATA%/Temp",
    "ApplicationDataDirectory": "%APPDATA%",
    "ExtractedResourcesDirectory": "%APPDATA%",
    "DisableSearchFilter": false,
    "RunBackgroundBrainIndexer": false,
    "ClientInfoExpirationInDays": 90,
    "ClientInfoCookieKey": "DekutronClientTokenGuid",
    "LinkedLocalResourcePrefix": "",
    "IPGeolocationAPIKey": "fixed:US",
    "Auth0": {
      // Auth0 tenant domain
      "Domain": "auth.thebrain.com",
      // Public client ID for this native app (Auth0 "Native" app type)
      "NativeClientId": "MGJBlE1sYFKTpk67zKkgNHO8Cc5ecXio",
      // Master feature flag — enables social login buttons
      "Enabled": true,
      // Comma-separated endpoint URLs where Auth0 is enabled (gates social buttons per endpoint)
      "AllowedEndpoints": "https://api.thebrain.com, https://internal.api.thebrain.com"
    }
  }
}

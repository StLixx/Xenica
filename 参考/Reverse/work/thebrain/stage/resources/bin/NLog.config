<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<targets>
		<target xsi:type="File" name="file" fileName="${var:logOutputDirectory}/Output.log" layout="${longdate:universalTime=true} | ${pad:padding=-5:fixedLength=true:inner=${uppercase:${level}}} | ${logger} | ${message}"
				archiveFileName="${var:logOutputDirectory}/Archive/{#####}.log" archiveEvery="Day" archiveNumbering="Date" maxArchiveFiles="5"/>
		<target xsi:type="Debugger" name="debugger" layout="${longdate:universalTime=true} | ${pad:padding=-5:fixedLength=true:inner=${uppercase:${level}}} | ${logger} | ${message}" />
		<target xsi:type="Console" name="console" layout="${longdate:universalTime=true} | ${pad:padding=-5:fixedLength=true:inner=${uppercase:${level}}} | ${logger} | ${message}" />
	</targets>
	<rules>
		<logger name="*" minlevel="Debug" writeTo="console" />
		<logger name="*" minlevel="Debug" writeTo="debugger, file" />
	</rules>
</nlog>

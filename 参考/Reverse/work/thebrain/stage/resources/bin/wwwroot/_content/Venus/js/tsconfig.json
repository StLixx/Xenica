{
  "compilerOptions": {
    "noEmitOnError": true,
    "noImplicitAny": true,
    "outDir": "dist",
    "sourceMap": true,
    "strict": true,
    "removeComments": true,
    "target": "es2017",
    "module": "esnext",     // or "es2020"
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "inlineSources": true
  },
  "include": [
    "./**/*.ts"
  ],
  "compileOnSave": true,
}
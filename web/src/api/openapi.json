    "/api/shares/{id}": {
      "delete": {
        "tags": ["shares"],
        "summary": "作废一条分享链接。",
        "operationId": "revoke_share",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Actor": {
        "oneOf": [
          {
            "type": "object",
            "description": "某个账号。旧痕迹（鉴权之前写的）没有 `id`。",
            "required": ["type"],
            "properties": {
              "id": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/UserId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": {
                "type": "string",
                "enum": ["user"]
              }
            }
          },
          {
            "type": "object",
            "description": "处理器（插件），带版本，便于以后重跑。",
            "required": ["id", "version", "type"],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["processor"]
              },
              "version": {
                "type": "string"
              }
            }
          }
        ],
        "description": "谁做的。规则 2：AI 和处理器只提议，人裁决——所以永远要分得清是谁写的。"
      },
      "Edge": {
        "type": "object",
        "description": "关系：两个节点之间有类型、有方向的连接。",
        "required": ["id", "source", "target", "kind", "created_at"],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "$ref": "#/components/schemas/EdgeId"
          },
          "kind": {
            "type": "string",
            "description": "关系类型键，例如 `related`。以后关系类型本身也会成为节点。"
          },
          "source": {
            "$ref": "#/components/schemas/NodeId"
          },
          "target": {
            "$ref": "#/components/schemas/NodeId"
          }
        }
      },
      "EdgeId": {
        "type": "string",
        "format": "uuid",
        "description": "关系 ID。"
      },
      "ErrorBody": {
        "type": "object",
        "description": "所有接口统一的错误格式。",
        "required": ["error", "message"],
        "properties": {
          "error": {
            "type": "string",
            "description": "机器可读：`invalid`、`unauthorized`（没登录）、`forbidden`、`not_found`、`conflict`、\n`locked`（输错太多次）、`internal`。"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "FileRef": {
        "type": "object",
        "required": ["id", "url"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "description": "在 Markdown 里引用用的地址，例如 `![](/api/files/…)`。"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status", "version"],
        "properties": {
          "commit": {
            "type": ["string", "null"],
            "description": "构建时的 git commit（镜像里由 CI 写入 `XENICA_COMMIT`），本地开发时为空。"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Login": {
        "type": "object",
        "required": ["name", "password"],
        "properties": {
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "NewChildren": {
        "type": "object",
        "description": "在某个节点里按顺序插入新的子节点（一次可以插多个，例如粘贴一整段笔记）。",
        "required": ["nodes"],
        "properties": {
          "index": {
            "type": ["integer", "null"],
            "format": "int32",
            "description": "插到第几个位置（从 0 开始）；省略时放到最后。",
            "minimum": 0
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NewNode"
            }
          }
        }
      },
      "NewEdge": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "kind": {
            "type": ["string", "null"],
            "description": "省略时为 `related`。"
          },
          "source": {
            "$ref": "#/components/schemas/NodeId"
          },
          "target": {
            "$ref": "#/components/schemas/NodeId"
          }
        }
      },
      "NewNode": {
        "type": "object",
        "description": "新建节点的输入。",
        "properties": {
          "body": {
            "type": ["object", "null"],
            "description": "约定：文字内容放在 `md`（Markdown），其中的 `#标记` 和 `[[名字]]` 会自动连到同名节点。"
          },
          "id": {
            "type": ["string", "null"],
            "format": "uuid",
            "description": "客户端可以自己生成 ID（UUID v7），这样不用等服务器就能接着编辑。省略时由服务器生成。"
          },
          "kind": {
            "type": ["string", "null"],
            "description": "省略时为 `note`。"
          },
          "title": {
            "type": "string",
            "description": "可省略。"
          }
        }
      },
      "NewShare": {
        "type": "object",
        "required": ["mode"],
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/ShareMode",
            "description": "`read`（给 AI 读）或 `write`（给 AI 改）。"
          }
        }
      },
      "Node": {
        "type": "object",
        "description": "节点：一切有身份的东西（知识点、文件、任务、设置……）。",
        "required": ["id", "kind", "title", "body", "created_at", "updated_at"],
        "properties": {
          "body": {
            "type": "object",
            "description": "节点内容。结构由类型决定，核心不解释它。"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "$ref": "#/components/schemas/NodeId"
          },
          "kind": {
            "type": "string",
            "description": "类型键，例如 `note`。以后类型本身也会成为节点，这里先用字符串。"
          },
          "title": {
            "type": "string",
            "description": "可以为空：没有标题时界面用正文第一行代替。"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NodeId": {
        "type": "string",
        "format": "uuid",
        "description": "节点 ID。身份只看 ID，不看名字。"
      },
      "NodePatch": {
        "type": "object",
        "description": "修改节点的输入。只改给出的字段。",
        "properties": {
          "body": {
            "type": ["object", "null"]
          },
          "title": {
            "type": ["string", "null"]
          }
        }
      },
      "SceneInput": {
        "type": "object",
        "required": ["scene"],
        "properties": {
          "scene": {
            "description": "Excalidraw 的画面数据，原样存下来。"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": ["setup_required", "demo"],
        "properties": {
          "demo": {
            "type": "boolean",
            "description": "示例数据模式（预览站）：可以用 `demo` / `demo` 登录。"
          },
          "setup_required": {
            "type": "boolean",
            "description": "还没有任何账号：界面显示「创建账号」，需要服务日志里的设置码。"
          },
          "user": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/User",
                "description": "当前登录的账号；没登录为空。"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Setup": {
        "type": "object",
        "required": ["code", "name", "password"],
        "properties": {
          "code": {
            "type": "string",
            "description": "服务启动时打印在日志里的一次性设置码。"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ShareBody": {
        "type": "object",
        "description": "一条分享链接（带好可以直接用的地址）。",
        "required": ["id", "node", "mode", "token", "url", "image", "created_at"],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "image": {
            "type": "string",
            "description": "画面图片。"
          },
          "mode": {
            "$ref": "#/components/schemas/ShareMode"
          },
          "node": {
            "type": "string",
            "format": "uuid"
          },
          "revoked_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "token": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "交给 AI 的地址：打开就是文字说明；write 链接也用这个地址改画面。"
          }
        }
      },
      "ShareMode": {
        "type": "string",
        "description": "分享链接的用法。决定拿到这个地址的人能做什么。",
        "enum": ["read", "write"]
      },
      "Trace": {
        "type": "object",
        "description": "痕迹：只增不改的事件记录（数据库触发器保证不能改、不能删）。",
        "required": ["id", "at", "actor", "action", "subject", "detail"],
        "properties": {
          "action": {
            "type": "string",
            "description": "例如 `node.created`、`edge.deleted`。"
          },
          "actor": {
            "$ref": "#/components/schemas/Actor"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "detail": {
            "type": "object"
          },
          "id": {
            "$ref": "#/components/schemas/TraceId"
          },
          "subject": {
            "type": "string",
            "format": "uuid",
            "description": "被操作的节点或关系的 ID。"
          }
        }
      },
      "TraceId": {
        "type": "string",
        "format": "uuid",
        "description": "痕迹 ID。"
      },
      "User": {
        "type": "object",
        "description": "账号。密码哈希不在这里：它只存在 store 里，永远不出现在接口上（规则 9）。",
        "required": ["id", "name", "created_at"],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "UserId": {
        "type": "string",
        "format": "uuid",
        "description": "账号 ID。"
      }
    }
  }
}

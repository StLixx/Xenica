{
  "openapi": "3.1.0",
  "info": {
    "title": "Xenica API",
    "description": "Xenica 的 HTTP 接口。由代码生成，不要手改。除 `/api/health` 和 `/api/auth/*` 外都要先登录（Cookie `xenica_session`）。",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "登录。同一用户名连续输错 5 次锁 15 分钟。",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "退出登录。没登录也返回 204。",
        "operationId": "logout",
        "responses": {
          "204": {}
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "tags": ["auth"],
        "summary": "当前会话（是否登录、是否需要首次设置）。",
        "operationId": "session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/setup": {
      "post": {
        "tags": ["auth"],
        "summary": "首次设置：库里还没有账号时，用设置码创建第一个账号并登录。",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Setup"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/edges": {
      "get": {
        "tags": ["edges"],
        "summary": "列出关系。",
        "operationId": "list_edges",
        "parameters": [
          {
            "name": "node",
            "in": "query",
            "description": "只返回与这个节点相连的关系。",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/NodeId"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "默认 2000，上限 5000。",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Edge"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["edges"],
        "summary": "新建关系。",
        "operationId": "create_edge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEdge"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Edge"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/edges/{id}": {
      "delete": {
        "tags": ["edges"],
        "summary": "删除关系。",
        "operationId": "delete_edge",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": ["system"],
        "summary": "健康检查：数据库可用时返回 200。",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/nodes": {
      "get": {
        "tags": ["nodes"],
        "summary": "列出节点（最近更新的在前）。",
        "operationId": "list_nodes",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "最多返回多少条，默认 200，上限 1000。",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Node"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["nodes"],
        "summary": "新建节点。",
        "operationId": "create_node",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewNode"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Node"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/nodes/{id}": {
      "get": {
        "tags": ["nodes"],
        "summary": "读取一个节点。",
        "operationId": "get_node",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Node"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["nodes"],
        "summary": "删除节点及其关系。痕迹保留。",
        "operationId": "delete_node",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["nodes"],
        "summary": "修改节点（只改给出的字段）。",
        "operationId": "update_node",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NodePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Node"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/nodes/{id}/traces": {
      "get": {
        "tags": ["nodes"],
        "summary": "节点的痕迹（谁、何时、做了什么）。",
        "operationId": "list_node_traces",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Trace"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Actor": {
        "oneOf": [
          {
            "type": "object",
            "description": "某个账号。旧痕迹（鉴权之前写的）没有 `id`。",
            "required": ["type"],
            "properties": {
              "id": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/UserId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": {
                "type": "string",
                "enum": ["user"]
              }
            }
          },
          {
            "type": "object",
            "description": "处理器（插件），带版本，便于以后重跑。",
            "required": ["id", "version", "type"],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["processor"]
              },
              "version": {
                "type": "string"
              }
            }
          }
        ],
        "description": "谁做的。规则 2：AI 和处理器只提议，人裁决——所以永远要分得清是谁写的。"
      },
      "Edge": {
        "type": "object",
        "description": "关系：两个节点之间有类型、有方向的连接。",
        "required": ["id", "source", "target", "kind", "created_at"],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "$ref": "#/components/schemas/EdgeId"
          },
          "kind": {
            "type": "string",
            "description": "关系类型键，例如 `related`。以后关系类型本身也会成为节点。"
          },
          "source": {
            "$ref": "#/components/schemas/NodeId"
          },
          "target": {
            "$ref": "#/components/schemas/NodeId"
          }
        }
      },
      "EdgeId": {
        "type": "string",
        "format": "uuid",
        "description": "关系 ID。"
      },
      "ErrorBody": {
        "type": "object",
        "description": "所有接口统一的错误格式。",
        "required": ["error", "message"],
        "properties": {
          "error": {
            "type": "string",
            "description": "机器可读：`invalid`、`unauthorized`（没登录）、`forbidden`、`not_found`、`conflict`、\n`locked`（输错太多次）、`internal`。"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status", "version"],
        "properties": {
          "commit": {
            "type": ["string", "null"],
            "description": "构建时的 git commit（镜像里由 CI 写入 `XENICA_COMMIT`），本地开发时为空。"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Login": {
        "type": "object",
        "required": ["name", "password"],
        "properties": {
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "NewEdge": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "kind": {
            "type": ["string", "null"],
            "description": "省略时为 `related`。"
          },
          "source": {
            "$ref": "#/components/schemas/NodeId"
          },
          "target": {
            "$ref": "#/components/schemas/NodeId"
          }
        }
      },
      "NewNode": {
        "type": "object",
        "description": "新建节点的输入。",
        "required": ["title"],
        "properties": {
          "body": {
            "type": ["object", "null"]
          },
          "kind": {
            "type": ["string", "null"],
            "description": "省略时为 `note`。"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "Node": {
        "type": "object",
        "description": "节点：一切有身份的东西（知识点、文件、任务、设置……）。",
        "required": ["id", "kind", "title", "body", "created_at", "updated_at"],
        "properties": {
          "body": {
            "type": "object",
            "description": "节点内容。结构由类型决定，核心不解释它。"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "$ref": "#/components/schemas/NodeId"
          },
          "kind": {
            "type": "string",
            "description": "类型键，例如 `note`。以后类型本身也会成为节点，这里先用字符串。"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NodeId": {
        "type": "string",
        "format": "uuid",
        "description": "节点 ID。身份只看 ID，不看名字。"
      },
      "NodePatch": {
        "type": "object",
        "description": "修改节点的输入。只改给出的字段。",
        "properties": {
          "body": {
            "type": ["object", "null"]
          },
          "title": {
            "type": ["string", "null"]
          }
        }
      },
      "Session": {
        "type": "object",
        "required": ["setup_required", "demo"],
        "properties": {
          "demo": {
            "type": "boolean",
            "description": "示例数据模式（预览站）：可以用 `demo` / `demo` 登录。"
          },
          "setup_required": {
            "type": "boolean",
            "description": "还没有任何账号：界面显示「创建账号」，需要服务日志里的设置码。"
          },
          "user": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/User",
                "description": "当前登录的账号；没登录为空。"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Setup": {
        "type": "object",
        "required": ["code", "name", "password"],
        "properties": {
          "code": {
            "type": "string",
            "description": "服务启动时打印在日志里的一次性设置码。"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Trace": {
        "type": "object",
        "description": "痕迹：只增不改的事件记录（数据库触发器保证不能改、不能删）。",
        "required": ["id", "at", "actor", "action", "subject", "detail"],
        "properties": {
          "action": {
            "type": "string",
            "description": "例如 `node.created`、`edge.deleted`。"
          },
          "actor": {
            "$ref": "#/components/schemas/Actor"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "detail": {
            "type": "object"
          },
          "id": {
            "$ref": "#/components/schemas/TraceId"
          },
          "subject": {
            "type": "string",
            "format": "uuid",
            "description": "被操作的节点或关系的 ID。"
          }
        }
      },
      "TraceId": {
        "type": "string",
        "format": "uuid",
        "description": "痕迹 ID。"
      },
      "User": {
        "type": "object",
        "description": "账号。密码哈希不在这里：它只存在 store 里，永远不出现在接口上（规则 9）。",
        "required": ["id", "name", "created_at"],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "UserId": {
        "type": "string",
        "format": "uuid",
        "description": "账号 ID。"
      }
    }
  }
}
